THREADS_ACCESS_TOKEN=
# Threads user ID (from GET https://graph.threads.net/v1.0/me?fields=id,username)
THREADS_USER_ID=

# Anthropic API key for content generation
ANTHROPIC_API_KEY=

# OpenAI API key for image generation (python/remake_image.py, DALL-E 3)
OPENAI_API_KEY=
